.DS_Store
.env
.env.*
!.env.example
.idea/
.pytest_cache/
.venv/
.vscode/
__pycache__/
*.py[cod]
*.log
cookies*.json
cookies*.txt
data/*
# 能力登记是随源码交付的静态基线配置（人工维护、非运行态数据），必须入库，
# 否则全新克隆/CI 缺文件时全平台被判 unavailable、任务创建一律 422。
!data/capabilities.json
downloads/
cache/
*.part
# Local signing keys, packaged release artifacts and audit snapshots must never
# be committed: extension/*.pem can sign browser extensions and data/certs holds
# a local mitmproxy CA private key.
*.pem
*.p12
*.crx
releases/
backups/
graphify-out/
*.corrupt-*.json
# 审计截图/历史产物与本地工具会话数据，不入库
审计产物/
artifacts/
.claude/
.zcode/
# 智能体会话与工作区记忆属运行态数据，禁止进入版本库
.workbuddy-ai/
# 本地开发日志（含内部修复过程细节），不发布
/完整修复推进记录.md
/CONTRIBUTING.md
/SECURITY.md
/CHANGELOG.md
docs/templates/
docs/records/
docs/archive/
scripts/excel-docs/
# 打包产物（未来分发用）
dist/
build/
# 系统杂项
Thumbs.db
desktop.ini
